{
  "title": "Streaming Backend",
  "uid": "streaming-backend",
  "editable": true,
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "type": "timeseries",
      "title": "Events received",
      "description": "Accepted events per second, split by type, over the visible time window — the raw ingest volume actually landing, not a snapshot total.",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (type) (rate(streaming_ingest_events_total[$__rate_interval]))",
          "legendFormat": "{{type}}",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "fillOpacity": 15, "stacking": { "mode": "normal" } } },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Alarms emitted",
      "description": "Distinct alarms per second published on the live feed after dedup, not raw fall_warn POSTs — jittered resends of the same physical fall are collapsed before this metric ever sees them.",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(streaming_alarms_emitted_total[$__rate_interval])",
          "legendFormat": "alarms",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Rejected, by reason",
      "description": "Rejected POST /events per second, split by reason — should sit near zero; spikes usually mean bad clock skew or malformed devices upstream, not a service bug.",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (reason) (rate(streaming_ingest_rejected_total[$__rate_interval]))",
          "legendFormat": "{{reason}}",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "fillOpacity": 15, "stacking": { "mode": "normal" } } },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Intake queue depth by lane",
      "description": "fall_warn (high-priority) and everything-else (normal) lanes of the intake limiter, where rising toward capacity (200 / 2000) means it's delaying producers under burst as intended, not dropping.",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "streaming_intake_queue_depth",
          "legendFormat": "{{lane}}",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    }
  ]
}
